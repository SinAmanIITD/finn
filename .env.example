DATABASE_URL="file:./dev.db"

# Multi-provider model routing: Groq for cheap/bulk work, OpenAI for the
# reasoning-heavy sections (and real embeddings-based retrieval). Without
# these, the app still runs end-to-end in a clearly-labelled "demo mode"
# using rule-based classification and BM25 retrieval with no synthesis.

# Cheap/bulk tier: announcement classification, one-line summaries.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Strong tier: research synthesis, guidance-vs-actuals, chat, and embeddings.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
